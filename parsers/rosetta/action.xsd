<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:complexType name="PenaltyItemType">
        <xs:sequence>
            <xs:element name="comp" type="xs:string"/>
            <xs:element name="selector_name" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PenaltiesType">
        <xs:sequence>
            <xs:element name="item" type="PenaltyItemType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RestrictionItemType">
        <xs:sequence>
            <xs:element name="type">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="restrict"/>
                        <xs:enumeration value="prohibit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="residues" type="xs:string"/>
            <xs:element name="selector_name" type="xs:string" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ResidueRestrictionsType">
        <xs:sequence>
            <xs:element name="item" type="RestrictionItemType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="action">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string" />
                <xs:element name="penalties" type="PenaltiesType" minOccurs="0" maxOccurs="1"/>
                <xs:element name="residue_restrictions" type="ResidueRestrictionsType" minOccurs="0" maxOccurs="1"/>
                <xs:element name="packing_restrictions" type="xs:string" minOccurs="0" maxOccurs="1"/>
                <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
            </xs:sequence>
            <xs:attribute name="tag" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="choose"/>
                        <xs:enumeration value="run"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
